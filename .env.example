# Base de données PostgreSQL (Supabase / Neon / Railway...)
# DATABASE_URL : connexion via pooler — utilisée par l'application en production (serverless)
# DIRECT_URL   : connexion directe/session — utilisée uniquement par les migrations Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/adressa?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/adressa?schema=public"

# NextAuth
NEXTAUTH_SECRET="changez-moi-avec-une-chaine-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"

# URL publique du site (utilisée pour le SEO / Open Graph et les QR codes)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cartographie (fond de carte OpenStreetMap par défaut, personnalisable)
NEXT_PUBLIC_MAP_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Stockage cloud des photos — Vercel Blob (par défaut, aligné avec le déploiement Vercel)
# Générez ce token dans Vercel : Storage → Blob → Create Store → .env.local
BLOB_READ_WRITE_TOKEN=""
STORAGE_URL=""

# Compte administrateur de démonstration (utilisé uniquement par prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@adressa.sn"
SEED_ADMIN_PASSWORD=""
